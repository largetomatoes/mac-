# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
# Checkout-local execution profile and tool state; never publish them.
/.sites-runtime/
/.agents/
/.codex/
/outputs/
/tmp/
/work/*

# Publish only the reproducible macOS shell sources. Personal data, books,
# dependencies, built apps, and release archives under work/ stay ignored.
!/work/mac-app/
/work/mac-app/*
!/work/mac-app/asar-src/
!/work/mac-app/asar-src/main.js
!/work/mac-app/asar-src/package.json
!/work/mac-app/asar-src/complete-backup.js
!/work/mac-app/asar-src/oss-cloud.js
!/work/mac-app/asar-src/library-location.js
!/work/mac-app/local-spa/
/work/mac-app/local-spa/*
!/work/mac-app/local-spa/index.html
!/work/mac-app/local-spa/main.tsx
!/work/mac-app/local-spa/vite.config.mjs
!/work/mac-app/local-spa/cloud-import.js
!/work/mac-app/AppIcon.iconset/
!/work/mac-app/AppIcon.iconset/*.png
!/work/mac-app/AppIcon.icns
!/work/mac-app/app-icon.svg
!/work/mac-app/build-icon.mjs
!/work/mac-app/AppIcon-win.ico
!/work/mac-app/native-Info.plist
!/work/mac-app/seed.json
!/work/mac-app/package.json
!/work/mac-app/package-lock.json
!/work/mac-app/scripts/
/work/mac-app/scripts/*
!/work/mac-app/scripts/build-windows.mjs
!/work/mac-app/scripts/build-mac.mjs

*.tsbuildinfo

!/work/mac-app/asar-src/zotero-local.js

!/work/mac-app/asar-src/library-import.js

/mobile/dist/
/mobile/public/
/android/.gradle/
/android/local.properties
/android/**/build/
/android/app/src/main/assets/public/
/android/app/src/main/assets/capacitor.config.json
/android/app/src/main/assets/capacitor.plugins.json
*.keystore
*.jks
!/work/mac-app/asar-src/nutstore-sync.cjs
!/work/mac-app/asar-src/local-sync-migration.cjs

!/work/mac-app/asar-src/app-updates.cjs
